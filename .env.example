# The demo is offline-safe by default. Change to live only after adding a
# server-side provider key below. Never expose these values as NEXT_PUBLIC_*.
HER_PROVIDER_MODE=mock

# Capability routing. Text capabilities support all five providers in live
# mode. Qwen is the only live image-context adapter in this demo.
HER_CHAT_PROVIDER=qwen
HER_SUMMARY_PROVIDER=qwen
HER_IMAGE_PROVIDER=qwen
HER_ASR_PROVIDER=qwen
HER_TTS_PROVIDER=qwen

# Optional per-capability model overrides. These take priority over the
# provider-level defaults farther below.
# HER_CHAT_MODEL=qwen3.7-plus
# HER_SUMMARY_MODEL=qwen3.7-flash
# HER_IMAGE_MODEL=qwen3.7-plus

# Provider credentials (server only). Configure only the providers you use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# QWEN_API_KEY=                       # accepted alias
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=                     # accepted alias

# Optional provider-level model overrides. Defaults are:
# DeepSeek deepseek-v4-flash; Qwen qwen3.7-plus; OpenAI gpt-5-mini;
# Anthropic claude-sonnet-4-6; Gemini gemini-2.5-flash.
# DEEPSEEK_MODEL=deepseek-v4-flash
# QWEN_MODEL=qwen3.7-plus
# QWEN_IMAGE_MODEL=qwen3.7-plus
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash

# Optional endpoint overrides. Qwen's default uses the legacy Beijing
# DashScope compatible endpoint, which remains supported. For a workspace-
# specific Model Studio domain, include /compatible-mode/v1 in QWEN_BASE_URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ANTHROPIC_VERSION=2023-06-01

# Upstream timeout, clamped between 5 and 120 seconds.
HER_PROVIDER_TIMEOUT_MS=45000
